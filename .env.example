# Firebase projekt beállítások (Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcionális: Iskolai Microsoft Entra ID (Azure AD) Tenant ID
# Ha nincs megadva, a Firebase alapértelmezett Microsoft bejelentkezést használja
VITE_MICROSOFT_TENANT_ID=

# Opcionális: Engedélyezett admin email domainek (vesszővel elválasztva, pl. akg.hu,akgbudapest.onmicrosoft.com) vagy konkrét email lista
VITE_ALLOWED_ADMIN_DOMAIN=
VITE_ALLOWED_ADMIN_EMAILS=
