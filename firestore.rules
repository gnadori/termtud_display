rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Csak a megadott iskolai Microsoft domainekről bejelentkezett felhasználók írhatnak
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@(akg\\.hu|akgbudapest\\.onmicrosoft\\.com)$');
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /funFacts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
